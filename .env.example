# Copy this file to .env and enter your local PostgreSQL settings.
# Spring Boot loads this file as Java properties: use unquoted values.
# Escape literal backslashes as \\ and do not add inline comments to values.
DB_URL=jdbc:postgresql://localhost:5432/jobtrackerdb
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DEMO_SEED_ENABLED=true
DEMO_SEED_PASSWORD=veryStrongPassword123!
